# Docker dev environment (compose.dev.yml)
# Copy to .env.docker, fill real values and: chmod 600 .env.docker
# Never commit .env.docker or paste its contents anywhere.

# Server (overridden by compose.dev.yml, kept here for reference)
PORT=2002
NODE_ENV=development

# Data (overridden by compose.dev.yml, kept here for reference)
DATA_DIR=/app/data

# PostgreSQL is the source of truth for jobs consumed by separate workers.
PERSISTENCE_DRIVER=postgres
# Must point at the internal "db" service, never at the host or internet.
DATABASE_URL=postgresql://aistickers:CHANGE_ME@db:5432/aistickers

# PostgreSQL (db service in compose.dev.yml). Not exposed outside the
# compose network. Generate a real password, never reuse an example value.
POSTGRES_USER=aistickers
POSTGRES_PASSWORD=your-postgres-password-here
POSTGRES_DB=aistickers

# BullMQ/Redis. Redis is internal-only; do not add a ports mapping in Compose.
REDIS_URL=redis://redis:6379
TRUST_PROXY=0
GENERATION_QUEUE_ENABLED=true
GENERATION_QUEUE_CONCURRENCY=2
GENERATION_QUEUE_ATTEMPTS=5
GENERATION_QUEUE_BACKOFF_MS=5000
GENERATION_QUEUE_TIMEOUT_MS=180000
GENERATION_QUEUE_STALLED_INTERVAL_MS=30000
GENERATION_QUEUE_LOCK_DURATION_MS=240000
GENERATION_QUEUE_RECONCILE_INTERVAL_MS=30000
GENERATION_QUEUE_SHUTDOWN_TIMEOUT_MS=30000

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_ISSUER=aiStickers
JWT_AUDIENCE=aiStickers-backend
JWT_EXPIRES_IN=15m

# Optional test JWTs. Development only — keep empty by default.
# Expected format: JSON array of JWT strings.
# TEST_JWTS=["eyJhbGciOi...test-token-1","eyJhbGciOi...test-token-2"]
TEST_JWTS=

# Google Auth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_PACKAGE_NAME=com.animatedsticker.aistickers

# Apple Auth (only required when ENABLE_APPLE_PAYMENTS=true)
APPLE_CLIENT_ID=your-apple-client-id

# HMAC (App Authentication)
CLIENT_ID=ai-stickers
CLIENT_SECRET=your-client-secret-here

# Google Play
GOOGLE_PLAY_SERVICE_ACCOUNT={"type":"service_account",...}

# i18n / POEditor
POEDITOR_API_TOKEN=your-poeditor-api-token
POEDITOR_PROJECT_ID=your-poeditor-project-id

# Replicate AI
REPLICATE_API_TOKEN=your-replicate-api-token
REPLICATE_MODEL=google/nano-banana
REPLICATE_IMG2VID_MODEL=bytedance/seedance-1-pro

# HMAC window
SIG_WINDOW_SEC=300
HMAC_LEGACY_V1_ENABLED=true

# T09 distributed security limits
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_AUTH_GOOGLE_PER_MINUTE=10
RATE_LIMIT_AUTH_TOKEN_PER_MINUTE=20
RATE_LIMIT_PAYMENT_PER_MINUTE=10
RATE_LIMIT_GENERATION_PER_MINUTE=5
RATE_LIMIT_GENERATION_ACTIVE=2
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_EXPORT_PER_MINUTE=10
RATE_LIMIT_STATUS_PER_MINUTE=60

# Feature flags (safe defaults)
ENABLE_APPLE_PAYMENTS=false
ENABLE_TELEGRAM=false
ENABLE_WHATSAPP_EXPORT=false
ENABLE_EXTERNAL_IMAGE_URLS=false
ENABLE_TEST_JWTS=false

# External image URL allowlist (JSON array of hostnames). Only used when
# ENABLE_EXTERNAL_IMAGE_URLS=true. Wildcard subdomains are not supported.
EXTERNAL_IMAGE_URL_ALLOWLIST=[]

# CORS origins (comma-separated). Wildcard is only allowed in development/test.
CORS_ORIGINS=

# Telegram Bot (only required when ENABLE_TELEGRAM=true)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Private object storage. Compose defaults to local for normal development.
ASSET_STORAGE_DRIVER=local
ASSET_STORAGE_BUCKET=aistickers-private-assets
ASSET_STORAGE_LOCAL_BASE_DIR=/app/data
ASSET_STORAGE_SIGNED_URL_EXPIRY_SECONDS=300
# Optional MinIO profile (dummy local credentials only):
# ASSET_STORAGE_DRIVER=s3
# ASSET_STORAGE_ENDPOINT=http://minio:9000
# ASSET_STORAGE_REGION=us-east-1
# ASSET_STORAGE_FORCE_PATH_STYLE=true
# ASSET_STORAGE_ACCESS_KEY_ID=minioadmin
# ASSET_STORAGE_SECRET_ACCESS_KEY=minioadmin123
# ASSET_STORAGE_SERVER_SIDE_ENCRYPTION is intentionally unset for local MinIO.
