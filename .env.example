# Server
PORT=22024
NODE_ENV=development

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_ISSUER=aiStickers
JWT_AUDIENCE=aiStickers-backend
JWT_EXPIRES_IN=15m

# Optional test JWTs. Development only. Leave empty or unset to disable test JWT support.
# Expected format: JSON array of JWT strings.
# TEST_JWTS=["eyJhbGciOi...test-token-1","eyJhbGciOi...test-token-2"]
TEST_JWTS=

# Google Auth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_PACKAGE_NAME=com.animatedsticker.aistickers

# Apple Auth (only required when ENABLE_APPLE_PAYMENTS=true)
APPLE_CLIENT_ID=your-apple-client-id

# HMAC (App Authentication)
CLIENT_ID=ai-stickers
CLIENT_SECRET=your-client-secret-here

# Data
DATA_DIR=/var/www/aiStickers_Backend/data

# Persistence (T05A): JSON files remain the source of truth until T05B ships
# the PostgreSQL repositories. 'postgres' is mandatory in production.
PERSISTENCE_DRIVER=json
# Required whenever PERSISTENCE_DRIVER=postgres (always required in production).
# DATABASE_URL=postgresql://user:password@localhost:5432/aistickers

# Google Play
GOOGLE_PLAY_SERVICE_ACCOUNT={"type":"service_account",...}

# i18n / POEditor
POEDITOR_API_TOKEN=your-poeditor-api-token
POEDITOR_PROJECT_ID=your-poeditor-project-id

# Replicate AI
REPLICATE_API_TOKEN=your-replicate-api-token
REPLICATE_MODEL=google/nano-banana
REPLICATE_IMG2VID_MODEL=bytedance/seedance-1-pro

# HMAC window
SIG_WINDOW_SEC=300

# Feature flags (safe defaults)
ENABLE_APPLE_PAYMENTS=false
ENABLE_TELEGRAM=false
ENABLE_WHATSAPP_EXPORT=false
ENABLE_EXTERNAL_IMAGE_URLS=false
ENABLE_TEST_JWTS=false

# External image URL allowlist (JSON array of hostnames). Only used when
# ENABLE_EXTERNAL_IMAGE_URLS=true. Wildcard subdomains are not supported.
EXTERNAL_IMAGE_URL_ALLOWLIST=[]

# CORS origins (comma-separated). Wildcard is only allowed in development/test.
# Example: CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=

# Telegram Bot (only required when ENABLE_TELEGRAM=true)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
