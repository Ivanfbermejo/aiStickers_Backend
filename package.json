        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^4.22.2",
        "google-auth-library": "^9.15.1",
        "googleapis": "^173.0.0",
        "helmet": "^8.0.0",
        "jsonwebtoken": "^9.0.2",
        "multer": "^2.2.0",
